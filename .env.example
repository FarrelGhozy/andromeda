# ANDROMEDA - Contoh Environment Variables (ROOT PROJEK)
# Copy file ini menjadi `.env` di root projek lalu isi dengan project kamu:
#   cp .env.example .env
# Terus sync ke aplikasi mobile sebelum `flutter run`:
#   cp .env mobile_app/.env
#
# Cara dapat URL & Key:
# 1. Buka https://supabase.com
# 2. Buat project baru (Free Tier)
# 3. Buka Project Settings -> API
# 4. Copy "Project URL" dan "anon public" key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-key-here
