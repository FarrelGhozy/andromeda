# ANDROMEDA bot_mock — contoh env lokal
# Bot ini baca env dengan urutan prioritas:
#   1. environment yang sudah ada (export manual)
#   2. tools/bot_mock/.env (file ini kalau lu copy)
#   3. ../../.env (root projek — SUMBER UTAMA, disarankan)
#   4. ../../mobile_app/.env (sync dari root)
#
# Paling gampang: nggak usah bikin file ini.
# Cukup pastikan root projek punya .env yang valid:
#   cp .env.example .env   (di root, lalu isi)
# Kalau mau env khusus buat bot, copy file ini:
#   cp .env.example .env    (di folder ini, lalu isi)

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-key-here
